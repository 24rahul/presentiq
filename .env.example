# PresentIQ Environment Variables
# Copy this file to .env and fill in your API keys

# OpenAI API Key (Required for Whisper transcription)
OPENAI_API_KEY=your_openai_api_key_here

# xAI API Key (Optional - only needed for Grok models)
XAI_API_KEY=your_xai_api_key_here

# Required for researcher Advanced Mode and REST API access, not the student portal.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep private for authorized researchers and API clients.
PRESENTIQ_ACCESS_TOKEN=
# Per-process limits shared by transcription and analysis using study access.
# Each transcription or full analysis counts as one request.
PRESENTIQ_REQUESTS_PER_MINUTE=120
PRESENTIQ_MAX_CONCURRENT_ANALYSES=20
AI_MODEL=gpt-5.5
FEEDBACK_TEMPERATURE=0.3

# Google Sheets Logging (Optional - for pilot study data collection)
# Path to your Google Cloud service account JSON key file; leave blank to disable.
GOOGLE_CREDENTIALS_PATH=
# Alternatively, set GOOGLE_CREDENTIALS_JSON to the service account JSON.
# The ID of the Google Sheet to log submissions to (from the sheet URL)
GOOGLE_SHEET_ID=
